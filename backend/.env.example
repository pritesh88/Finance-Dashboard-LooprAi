# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# ---- MongoDB ----
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=finance_dashboard

# ---- Auth ----
# REQUIRED. Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1h

# ---- Seed script (npm run seed) ----
# Credentials of the login user created by the seed script.
# The dataset itself has no login accounts, so this user is created separately.
SEED_ADMIN_EMAIL=analyst@example.com
# Quote the value if it contains '#' (an unquoted # starts a comment in .env files).
SEED_ADMIN_PASSWORD="change-me-please"
SEED_ADMIN_NAME=Financial Analyst
# Optional: path to a different transactions JSON file (default: backend/data/transactions.json)
# SEED_FILE=./data/transactions.json

# ---- Export ----
# Safety cap on the number of rows a single CSV export may contain
MAX_EXPORT_ROWS=50000
